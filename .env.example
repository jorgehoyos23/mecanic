# Copia este archivo como .env y completa tus datos de MySQL.
# Con DB_MOTOR=mysql, Mecasolic crea una base de datos por microservicio:
#   mecasolic_auth, mecasolic_clientes, mecasolic_mecanicos, mecasolic_servicios,
#   mecasolic_ordenes, mecasolic_inventario, mecasolic_facturacion, mecasolic_notificaciones
DB_MOTOR=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=escribe_aqui_tu_contraseña
MYSQL_PREFIJO=mecasolic_

# Secreto para firmar los tokens JWT (mínimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-unico
